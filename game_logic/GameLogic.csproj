<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>GameLogic</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Lets tests call internal calculation methods directly instead of via reflection,
         without putting them on the public API the Godot frontend assembly sees. -->
    <InternalsVisibleTo Include="GameLogicTests" />
  </ItemGroup>

</Project>
